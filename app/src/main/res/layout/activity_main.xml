<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingLeft="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEB RÁDIO"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vem Comigo Deus"
                    android:textColor="@color/gold"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <ImageView
                android:layout_width="235dp"
                android:layout_height="235dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● AO VIVO"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Web Rádio Vem Comigo Deus"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Louvores • Palavra • Mensagem de Fé"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="255dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/minus"
                    android:layout_width="72dp"
                    android:layout_height="56dp"
                    android:text="−"
                    android:textSize="26sp"
                    android:textColor="@color/white"
                    android:background="@drawable/card"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOLUME"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/plus"
                    android:layout_width="72dp"
                    android:layout_height="56dp"
                    android:text="+"
                    android:textSize="26sp"
                    android:textColor="@color/white"
                    android:background="@drawable/card"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/bible"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:text="📖\nBÍBLIA\nSAGRADA"
                android:textColor="@color/white"
                android:background="@drawable/card"/>

            <Button
                android:id="@+id/dev"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:text="🙏\nDEVOCIONAL"
                android:textColor="@color/white"
                android:background="@drawable/card"
                android:layout_marginHorizontal="8dp"/>

            <Button
                android:id="@+id/word"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:text="💬\nPALAVRA\nDO DIA"
                android:textColor="@color/white"
                android:background="@drawable/card"/>
        </LinearLayout>

        <Button
            android:id="@+id/share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COMPARTILHAR RÁDIO"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/green"
            android:layout_marginTop="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O áudio vem do mesmo sinal Caster.fm usado pelo site."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="10dp"/>
    </LinearLayout>
</ScrollView>
