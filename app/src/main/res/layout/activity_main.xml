<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@mipmap/ic_launcher"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="10dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WEB RÁDIO" android:textColor="@color/white" android:textStyle="bold" android:textSize="22sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vem Comigo Deus" android:textColor="@color/gold" android:textStyle="bold" android:textSize="18sp"/>
</LinearLayout><TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--" android:textColor="@color/white" android:textStyle="bold" android:textSize="22sp"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:background="@drawable/card" android:padding="18dp" android:layout_marginTop="14dp">
<ImageView android:layout_width="270dp" android:layout_height="270dp" android:src="@mipmap/ic_launcher"/>
<TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● AO VIVO" android:textColor="@color/green" android:textStyle="bold" android:textSize="16sp" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Web Rádio Vem Comigo Deus" android:textColor="@color/white" android:textStyle="bold" android:textSize="24sp" android:gravity="center"/>
<TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transmissão ao vivo" android:textColor="@color/muted" android:textSize="16sp" android:gravity="center"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/minus" android:layout_width="64dp" android:layout_height="64dp" android:text="−" android:textSize="28sp" android:textColor="@color/white" android:background="@drawable/card"/>
<Button android:id="@+id/play" android:layout_width="116dp" android:layout_height="72dp" android:text="▶" android:textSize="30sp" android:textColor="@color/white" android:background="@drawable/green" android:layout_marginHorizontal="18dp"/>
<Button android:id="@+id/plus" android:layout_width="64dp" android:layout_height="64dp" android:text="+" android:textSize="28sp" android:textColor="@color/white" android:background="@drawable/card"/>
</LinearLayout></LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<Button android:id="@+id/bible" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:text="📖
BÍBLIA
SAGRADA" android:textColor="@color/white" android:background="@drawable/card"/>
<Button android:id="@+id/dev" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:text="🙏
DEVOCIONAL" android:textColor="@color/white" android:background="@drawable/card" android:layout_marginHorizontal="8dp"/>
<Button android:id="@+id/word" android:layout_width="0dp" android:layout_height="130dp" android:layout_weight="1" android:text="💬
PALAVRA
DO DIA" android:textColor="@color/white" android:background="@drawable/card"/>
</LinearLayout>
<Button android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COMPARTILHAR RÁDIO" android:textColor="@color/white" android:textStyle="bold" android:background="@drawable/green" android:layout_marginTop="14dp"/>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Toque no play para ouvir." android:textColor="@color/muted" android:gravity="center" android:padding="12dp"/>
</LinearLayout></ScrollView>